{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalStream",
  "version": "0.1.0",
  "identifier": "dev.localstream.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LocalStream",
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; media-src 'self' http://127.0.0.1:* blob:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": false,
    "resources": {
      "../dist/": "web/"
    }
  }
}
